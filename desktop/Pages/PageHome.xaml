<Page x:Class="PCLNeo.PageHome"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent" FontFamily="Microsoft YaHei UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
        <StackPanel>

            <!-- 启动 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="启动游戏" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="游戏版本" VerticalAlignment="Center"/>
                        <Grid Grid.Row="0" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ComboVersion" Margin="0,3"/>
                            <Button Grid.Column="1" x:Name="BtnGoDownload" Content="下载新版本" Margin="8,3,0,3"/>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="游戏账号" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ComboAccount" Grid.Row="1" Grid.Column="1" Margin="0,3"/>

                        <TextBlock Grid.Row="2" Text="Java 路径" VerticalAlignment="Center"/>
                        <Grid Grid.Row="2" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ComboJava" Margin="0,3"/>
                            <Button Grid.Column="1" x:Name="BtnScanJava" Content="扫描" Margin="8,3,0,3"/>
                            <Button Grid.Column="2" x:Name="BtnGetJava" Content="下载 Java" Margin="8,3,0,3"/>
                        </Grid>
                    </Grid>

                    <Button x:Name="BtnLaunch" Style="{StaticResource BtnPrimary}" Content="启动游戏" Margin="0,12,0,6"/>
                    <TextBlock x:Name="TxtLaunch" Text="就绪" Foreground="{StaticResource BrushGray}" FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- 账号 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="账号管理" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="用户名" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtUser" Grid.Column="1" Margin="0,3"/>
                        <TextBlock Grid.Row="1" Text="密码" VerticalAlignment="Center"/>
                        <PasswordBox x:Name="TxtPwd" Grid.Row="1" Grid.Column="1" Margin="0,3" Padding="8,5"/>
                        <TextBlock Grid.Row="2" Text="外置地址" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtYgg" Grid.Row="2" Grid.Column="1" Margin="0,3" ToolTip="外置登录（Yggdrasil）服务器地址，例如 https://example.com/api/yggdrasil"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="BtnLoginOffline" Content="离线登录"/>
                        <Button x:Name="BtnLoginYgg" Content="外置登录" Margin="8,0,0,0"/>
                        <Button x:Name="BtnLoginMs" Content="微软正版登录" Margin="8,0,0,0"/>
                        <Button x:Name="BtnDelAccount" Content="删除当前账号" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="提示：离线登录可随意填写用户名；外置登录需填写服务器地址；微软登录会弹出设备代码，请在浏览器中完成授权。" 
                               FontSize="11" Foreground="{StaticResource BrushGray}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- 日志 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="最近日志" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBox x:Name="TxtLog" Height="150" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
