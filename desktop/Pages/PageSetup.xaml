<Page x:Class="PCLNeo.PageSetup"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent" FontFamily="Microsoft YaHei UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
        <StackPanel>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="游戏目录" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox x:Name="TxtMcPath" Grid.Column="1" Margin="0,4"/>
                    <Button x:Name="BtnBrowseMc" Grid.Column="2" Content="浏览…" Margin="8,4,0,4"/>

                    <TextBlock Grid.Row="1" Text="Java 路径" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox x:Name="TxtJava" Grid.Column="1" Grid.Row="1" Margin="0,4"/>
                    <Button x:Name="BtnBrowseJava" Grid.Column="2" Grid.Row="1" Content="浏览…" Margin="8,4,0,4"/>

                    <TextBlock Grid.Row="2" Text="最大内存 (MB)" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox x:Name="TxtMemMax" Grid.Column="1" Grid.Row="2" Margin="0,4"/>

                    <TextBlock Grid.Row="3" Text="最小内存 (MB)" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox x:Name="TxtMemMin" Grid.Column="1" Grid.Row="3" Margin="0,4"/>

                    <TextBlock Grid.Row="4" Text="下载源" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox x:Name="ComboSource" Grid.Column="1" Grid.Row="4" Margin="0,4">
                        <ComboBoxItem Content="BMCLAPI 国内镜像（推荐）"/>
                        <ComboBoxItem Content="官方源"/>
                    </ComboBox>

                    <TextBlock Grid.Row="5" Text="版本隔离" VerticalAlignment="Center" Margin="0,4"/>
                    <CheckBox x:Name="ChkIsolate" Grid.Column="1" Grid.Row="5" Content="每个版本使用独立的 mods / 存档目录" Margin="0,6"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="账号与平台" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="CurseForge Key" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBox x:Name="TxtCfKey" Grid.Column="1" Margin="0,4"/>
                        <TextBlock Grid.Row="1" Text="微软 Client ID" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBox x:Name="TxtMsId" Grid.Column="1" Grid.Row="1" Margin="0,4"/>
                        <TextBlock Grid.Row="2" Text="外置登录地址" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBox x:Name="TxtYggDef" Grid.Column="1" Grid.Row="2" Margin="0,4"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="启动参数" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="JVM 参数" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBox x:Name="TxtJvmArgs" Grid.Column="1" Margin="0,4"/>
                        <TextBlock Grid.Row="1" Text="游戏参数" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBox x:Name="TxtGameArgs" Grid.Column="1" Grid.Row="1" Margin="0,4"/>
                        <TextBlock Grid.Row="2" Text="窗口大小" VerticalAlignment="Center" Margin="0,4"/>
                        <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Horizontal" Margin="0,4">
                            <CheckBox x:Name="ChkCustomSize" Content="自定义" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtWidth" Width="70" Margin="12,0,0,0"/>
                            <TextBlock Text="×" VerticalAlignment="Center" Margin="6,0"/>
                            <TextBox x:Name="TxtHeight" Width="70"/>
                            <CheckBox x:Name="ChkFullscreen" Content="全屏" Margin="16,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Row="3" Text="其它" VerticalAlignment="Center" Margin="0,4"/>
                        <StackPanel Grid.Column="1" Grid.Row="3" Orientation="Horizontal" Margin="0,4">
                            <CheckBox x:Name="ChkHideConsole" Content="隐藏控制台窗口" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkZgc" Content="使用 ZGC 垃圾回收" Margin="16,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,20">
                <Button x:Name="BtnSave" Content="保存设置" Width="120"/>
                <Button x:Name="BtnOpenData" Content="打开数据目录" Margin="10,0,0,0"/>
                <TextBlock x:Name="TxtHint" Text="" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="Gray"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
