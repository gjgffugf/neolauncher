<Page x:Class="PCLNeo.PageDownload"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent" FontFamily="Microsoft YaHei UI">
    <TabControl x:Name="Tabs" Margin="10" BorderThickness="0">

        <!-- ============ 版本下载 ============ -->
        <TabItem Header="版本下载">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <CheckBox x:Name="ChkRelease" Content="正式版" IsChecked="True" VerticalAlignment="Center"/>
                    <CheckBox x:Name="ChkSnapshot" Content="快照" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="ChkOld" Content="远古版" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtFilter" Width="160" Margin="16,0,0,0"/>
                    <Button x:Name="BtnRefreshList" Content="刷新列表" Margin="8,0,0,0"/>
                    <Button x:Name="BtnInstallVersion" Content="下载安装选中版本" Margin="8,0,0,0"/>
                </StackPanel>

                <ListBox x:Name="ListVersions" Grid.Row="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Text="{Binding Id}" Width="150" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Type}" Width="90" Foreground="Gray"/>
                                <TextBlock Text="{Binding ReleaseTime}" Foreground="Gray"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="2" x:Name="TxtVerHint" Text="提示：默认使用 BMCLAPI 国内镜像，可在设置中切换官方源" 
                           FontSize="11" Foreground="Gray" Margin="0,8,0,0"/>
            </Grid>
        </TabItem>

        <!-- ============ Mod 下载 ============ -->
        <TabItem Header="Mod 下载">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="150"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ComboBox x:Name="ComboSource" Width="110">
                        <ComboBoxItem Content="Modrinth" IsSelected="True"/>
                        <ComboBoxItem Content="CurseForge"/>
                    </ComboBox>
                    <TextBox x:Name="TxtKeyword" Width="200" Margin="8,0,0,0"/>
                    <ComboBox x:Name="ComboMcVer" Width="110" Margin="8,0,0,0"/>
                    <ComboBox x:Name="ComboLoader" Width="100" Margin="8,0,0,0">
                        <ComboBoxItem Content="Any" IsSelected="True"/>
                        <ComboBoxItem Content="fabric"/>
                        <ComboBoxItem Content="forge"/>
                        <ComboBoxItem Content="neoforge"/>
                        <ComboBoxItem Content="quilt"/>
                    </ComboBox>
                    <Button x:Name="BtnSearch" Content="搜索" Margin="8,0,0,0"/>
                </StackPanel>

                <ListBox x:Name="ListMods" Grid.Row="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Description}" Foreground="Gray" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,4">
                    <TextBlock Text="可用版本：" VerticalAlignment="Center"/>
                    <Button x:Name="BtnLoadFiles" Content="加载版本列表" Margin="8,0,0,0"/>
                    <TextBlock Text="安装到：" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <ComboBox x:Name="ComboTarget" Width="220" Margin="8,0,0,0"/>
                    <Button x:Name="BtnInstallMod" Content="安装选中版本" Margin="8,0,0,0"/>
                </StackPanel>

                <ListBox x:Name="ListFiles" Grid.Row="3" DisplayMemberPath="Name"/>

                <TextBlock Grid.Row="4" x:Name="TxtModHint" Text="CurseForge 需要在设置中填写 API Key" FontSize="11" Foreground="Gray" Margin="0,6,0,0"/>
            </Grid>
        </TabItem>

        <!-- ============ 整合包 ============ -->
        <TabItem Header="整合包">
            <StackPanel Margin="10">
                <TextBlock Text="导入整合包（.mrpack / CurseForge .zip）" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="TxtPackPath" Width="420"/>
                    <Button x:Name="BtnBrowsePack" Content="浏览…" Margin="8,0,0,0"/>
                    <Button x:Name="BtnImportPack" Content="导入" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock Text="导入后会创建一个独立实例目录（数据目录\instances），并自动切换为当前游戏目录；可在「版本」页的实例列表中随时切回。" 
                           FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,10,0,0"/>
                <ListBox x:Name="ListInstances" Height="220" Margin="0,12,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="BtnSwitchInstance" Content="切换到选中实例"/>
                    <Button x:Name="BtnRefreshInstances" Content="刷新" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </TabItem>

    </TabControl>
</Page>
