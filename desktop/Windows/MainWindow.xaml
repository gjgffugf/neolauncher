<Window x:Class="PCLNeo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PCLNeo"
        Title="PCL Neo" Height="660" Width="1020" MinWidth="900" MinHeight="580"
        Background="{StaticResource BrushBg}" WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI" SnapsToDevicePixels="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航：与 PCL2 一致的侧栏布局 -->
        <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="16,20,0,14">
                    <TextBlock Text="PCL Neo" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}"/>
                    <TextBlock Text="Minecraft 启动器" FontSize="12" Foreground="{StaticResource BrushGray}" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button x:Name="BtnNavHome" Style="{StaticResource BtnNav}" Content="启动"/>
                    <Button x:Name="BtnNavDownload" Style="{StaticResource BtnNav}" Content="下载"/>
                    <Button x:Name="BtnNavVersion" Style="{StaticResource BtnNav}" Content="版本"/>
                    <Button x:Name="BtnNavSetup" Style="{StaticResource BtnNav}" Content="设置"/>
                    <Button x:Name="BtnNavLog" Style="{StaticResource BtnNav}" Content="日志"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="14,0,14,14">
                    <TextBlock x:Name="TxtVersion" Text="PCL Neo" FontSize="11" Foreground="{StaticResource BrushGray}"/>
                    <TextBlock x:Name="TxtStatus" Text="就绪" FontSize="11" Foreground="{StaticResource BrushGray}" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" Margin="2"/>

            <!-- 底部全局进度条：所有下载 / 安装任务共用 -->
            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="14,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TxtProgress" Text="就绪" FontSize="12" Foreground="{StaticResource BrushGray}" Margin="0,0,0,4"/>
                    <ProgressBar x:Name="BarProgress" Grid.Row="1" Height="6" Value="0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
